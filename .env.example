# ═══════════════════════════════════════════
#  Aisha Agent — Environment Configuration
# ═══════════════════════════════════════════

# ── REQUIRED: Add your Gemini API Key ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (defaults work for local dev) ──
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wa_romantic
POSTGRES_PORT=5432

# ── Redis ──
REDIS_URL=redis://localhost:6379/1

# ── Internal Service URLs (don't change unless you know what you're doing) ──
GO_GATEWAY_URL=http://localhost:5005
WEBHOOK_URL=http://127.0.0.1:5001/api/v1/webhook/message

# ── Database for WhatsApp sessions (shared with gateway) ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wa_mark2
DB_SSLMODE=disable
